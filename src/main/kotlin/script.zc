func add(a: num, b: num): num {
	a + a;
}

func main() {
	createPlayer("e", 3);
}

func createPlayer(name: str, max_health: num): Player {
	val a = {
		val a = 6;
		val b = 11;
		a + b;
	};
	Player { name: name, cooldown: false, health: max_health, max_health: max_health };
}

struct Player {
	name: str,
	health: num,
	max_health: num,
	cooldown: bool
}